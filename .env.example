# =============================================================================
# Trading Assistant - Environment Configuration
# =============================================================================
# Copy this file to ".env" and fill in your real values:
#
#     copy .env.example .env            (Windows PowerShell/cmd)
#     cp .env.example .env              (bash)
#
# NEVER commit the real .env file - it is already listed in .gitignore.
# Values below are SAFE PLACEHOLDERS. Replace every one before going live.
# =============================================================================

# -----------------------------------------------------------------------------
# MetaTrader 5 (required for live order execution)
# -----------------------------------------------------------------------------
# Your MT5 account number (integer, digits only).
MT5_LOGIN=12345678

# The MT5 account password (the one you use to log into the trading account,
# NOT the investor/read-only password).
MT5_PASSWORD=your_mt5_password

# The exact broker server name as shown in the MT5 login dialog,
# e.g. "ICMarkets-Demo", "MetaQuotes-Demo", "FTMO-Demo".
MT5_SERVER=ICMarkets-Demo

# Full path to the MT5 terminal executable (64-bit is required).
# Leave blank to let the API auto-detect a single running terminal.
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Optional broker symbol suffix. Many brokers name symbols like "EURUSD.r" or
# "EURUSDm". The plan matcher always works with the base symbol (e.g. "EURUSD")
# and this suffix is appended only at execution time. Leave blank if unsure.
MT5_DEFAULT_SUFFIX=

# -----------------------------------------------------------------------------
# Telegram (required for mobile notifications)
# -----------------------------------------------------------------------------
# Create a bot with @BotFather and paste the token here.
# Format looks like: 123456789:AAExampleTokenStringFromBotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenStringFromBotFather

# The chat ID that should receive alerts. See SETUP.md for how to find it.
# Can be a personal chat ID (e.g. 987654321) or a group ID (e.g. -1001234567890).
TELEGRAM_CHAT_ID=987654321

# -----------------------------------------------------------------------------
# Notion (optional - trade journaling)
# -----------------------------------------------------------------------------
# Leave both blank to disable Notion logging. The server will still run.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# -----------------------------------------------------------------------------
# Obsidian (optional - local markdown trade journal)
# -----------------------------------------------------------------------------
# Path to your Obsidian vault root. A "Trade_Logs" subfolder is created
# automatically and a daily note (YYYY-MM-DD.md) is appended to.
# Leave blank to disable Obsidian logging.
OBSIDIAN_VAULT_PATH=

# -----------------------------------------------------------------------------
# Email (optional - send every notification to an email address too)
# -----------------------------------------------------------------------------
# Leave SMTP_HOST blank to disable email entirely. When configured, every
# signal alert, unplanned alert, startup ping, daily digest and watchdog alert
# is ALSO emailed to NOTIFY_EMAIL_TO.
#
# Gmail example (use an App Password, not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_USE_SSL=false
#   SMTP_USERNAME=your.sender@gmail.com
#   SMTP_PASSWORD=your_16_char_app_password
#   SMTP_FROM=your.sender@gmail.com
#
# For port 465 (implicit SSL): set SMTP_PORT=465, SMTP_USE_SSL=true,
# SMTP_USE_TLS=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Where notification emails are delivered.
NOTIFY_EMAIL_TO=nodeswavemonitor@gmail.com

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Port the Flask server listens on. Must match the MQL5 EA InpWebhookURL.
FLASK_PORT=5000

# Shared secret required in the X-API-Key header of every webhook request.
# Generate a long random string, e.g.:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change_me_to_a_long_random_secret

# -----------------------------------------------------------------------------
# Trading defaults (used when a plan omits these values)
# -----------------------------------------------------------------------------
# Fallback order volume in lots.
DEFAULT_VOLUME=0.01

# Fallback stop loss distance in broker points (1 point = 1 pip for 5-digit FX).
DEFAULT_STOP_LOSS=200

# Fallback take profit distance in broker points.
DEFAULT_TAKE_PROFIT=400

# -----------------------------------------------------------------------------
# Pre-flight risk limits (sanity checks run BEFORE any order is sent)
# -----------------------------------------------------------------------------
# These catch fat-finger mistakes (e.g. volume: 10 instead of 0.10) that would
# otherwise sail through order_check if margin allows.
#
# Reject an order when its volume exceeds this many lots.
MAX_VOLUME=1.0

# Reject an order when its stop-loss distance (points) is below this.
MIN_SL_POINTS=50

# Reject an order when the calculated loss at the stop-loss (in the account's
# currency, using the symbol's tick value) exceeds this amount.
MAX_RISK_PER_TRADE=50.0

# -----------------------------------------------------------------------------
# Risk / safety
# -----------------------------------------------------------------------------
# Master switch. Set to "false" to run in ALERT-ONLY mode: the system matches
# signals and notifies you, but NEVER places an order. Great for testing.
LIVE_TRADING=true

# Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
